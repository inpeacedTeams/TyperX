<Window x:Class="TyperX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TyperX" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F7F6F2" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#25232A"/>
        <SolidColorBrush x:Key="Muted" Color="#716E78"/>
        <SolidColorBrush x:Key="Line" Color="#DDD9E2"/>
        <SolidColorBrush x:Key="Paper" Color="#FCFBF8"/>
        <SolidColorBrush x:Key="Accent" Color="#6941C6"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#ECE9F0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#FAF8FF"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F2F0F4"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,6"/></Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource Accent}" Margin="0,0,12,0">
                    <TextBlock Text="Tx" Foreground="#FAF8FF" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel><TextBlock Text="TyperX" FontSize="24" FontWeight="Bold"/><TextBlock Text="human rhythm, smart messages" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#EDE9F7" CornerRadius="999" Padding="13,7" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Готов · F8 старт · F9 стоп" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Paper}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="ШАБЛОНЫ" Style="{StaticResource SectionLabel}"/>
                    <ListBox x:Name="TemplateList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="TemplateList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="11,10"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDE9F7"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1EEF4"/></Trigger></Style.Triggers>
                        </Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Новый" Click="NewTemplate_Click"/><Button Grid.Column="2" Content="Сохранить" Click="SaveTemplate_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Paper}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplateName" FontSize="19" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0,0,12,8" Text="Новый шаблон"/>
                        <TextBlock Grid.Column="1" x:Name="CharCount" Text="0 знаков" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged"
                             ToolTip="Вставь текст. TyperX разобьёт его на естественные сообщения."/>
                    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="ПРЕДПРОСМОТР СООБЩЕНИЙ" Style="{StaticResource SectionLabel}"/>
                        <ListBox x:Name="PreviewList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Border Background="#EEEAF8" CornerRadius="12,12,12,3" Padding="11,8" Margin="0,0,42,6" HorizontalAlignment="Left" MaxWidth="520">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#3F2C72" FontSize="13"/>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource Paper}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="РИТМ" Style="{StaticResource SectionLabel}"/>
                    <Grid><TextBlock Text="Скорость"/><TextBlock x:Name="WpmValue" Text="110 WPM" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
                    <Slider x:Name="WpmSlider" Minimum="35" Maximum="260" Value="110" TickFrequency="5" ValueChanged="Settings_Changed" Margin="0,7,0,16"/>
                    <Grid><TextBlock Text="Разброс"/><TextBlock x:Name="VariationValue" Text="22%" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
                    <Slider x:Name="VariationSlider" Minimum="0" Maximum="45" Value="22" ValueChanged="Settings_Changed" Margin="0,7,0,16"/>
                    <Grid><TextBlock Text="Опечатки"/><TextBlock x:Name="TypoValue" Text="1.5%" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid>
                    <Slider x:Name="TypoSlider" Minimum="0" Maximum="6" Value="1.5" TickFrequency="0.5" ValueChanged="Settings_Changed" Margin="0,7,0,20"/>
                    <Separator Background="{StaticResource Line}" Margin="0,0,0,16"/>
                    <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource SectionLabel}"/>
                    <CheckBox x:Name="SmartSplitCheck" Content="Умно делить на сообщения" IsChecked="True" Click="Settings_Changed"/>
                    <CheckBox x:Name="TyposCheck" Content="Исправлять редкие опечатки" IsChecked="True" Click="Settings_Changed"/>
                    <CheckBox x:Name="PunctuationPauseCheck" Content="Задумываться после знаков" IsChecked="True" Click="Settings_Changed"/>
                    <CheckBox x:Name="KeepPunctuationCheck" Content="Сохранять пунктуацию" IsChecked="True" Click="Settings_Changed"/>
                    <Border Background="#F2EFF8" CornerRadius="12" Padding="12" Margin="0,18,0,18">
                        <TextBlock Text="Enter нажимается после каждой смысловой реплики. Пауза зависит от длины и знаков, а не от ровного таймера." TextWrapping="Wrap" Foreground="#594A72" FontSize="12" LineHeight="18"/>
                    </Border>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Начать через 3 секунды" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="Остановить · F9" Click="StopButton_Click" IsEnabled="False" Margin="0,8,0,0"/>
                    <TextBlock Text="F8 запускает прямо в активном окне" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,16,2,0"><TextBlock Text="Локально на устройстве · без аккаунта · без облака" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Windows 10/11" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
    </Grid>
</Window>
